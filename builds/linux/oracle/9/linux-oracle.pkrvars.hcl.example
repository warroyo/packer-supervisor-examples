/*
    DESCRIPTION:
    Oracle Linux 9 build variables (example).
    Packer Plugin for VMware vSphere: 'vsphere-supervisor' builder.

    Copy to linux-oracle.pkrvars.hcl and edit before running.

    Prerequisites: run `make remaster` to build the custom ISO, then either:
      - `make upload` to push it to the content library via govc (recommended), or
      - host it at a URL reachable by the Supervisor cluster and set import_source_url.
    Then run `make build` (or `make all-local` / `make all-url` for a single command).
*/

// Source ISO (remaster-iso build stage)
//   source_iso_sha256 is optional but recommended — the cache is reused when
//   the checksum matches and re-downloaded automatically on mismatch.
source_iso_url    = "https://yum.oracle.com/ISOS/OracleLinux/OL9/u5/x86_64/OracleLinux-R9-U5-x86_64-dvd.iso"
source_iso_sha256 = ""

// govc Connection (upload-iso build stage)
//   Used by `make upload` to push the remastered ISO into the content library.
//   Prefer setting sensitive values via environment variables:
//     export PKR_VAR_govc_password="..."
govc_url         = "https://vcenter.example.com"
govc_username    = "administrator@vsphere.local"
govc_password    = ""
govc_insecure    = false
upload_overwrite = false   # set true to replace an existing library item

// Supervisor Connection
//   Leave kubeconfig_path / supervisor_namespace empty to use the
//   KUBECONFIG environment variable (or $HOME/.kube/config) and the
//   namespace of the current kubeconfig context.
kubeconfig_path      = ""
supervisor_namespace = "wcp-oracle-build"

// Source Image Import
//   Two paths for getting the remastered ISO into the content library:
//
//   A) govc upload (recommended — run `make upload`):
//      Leave import_source_url empty. The Makefile uploads .build/oraclelinux-9-ks.iso
//      directly using `govc library.import`. Packer skips the import step and uses
//      the already-present library item via image_name.
//
//   B) Hosted URL (run `make all-url`):
//      Set import_source_url to an HTTPS endpoint reachable by the Supervisor
//      cluster. Packer will submit a ContentLibraryItemImportRequest on first run.
//
import_source_url           = ""
import_target_location_name = "oracle-linux-source"
import_target_image_type    = "iso"
import_target_image_name    = "oraclelinux-9-ks"
watch_import_timeout_sec    = 1800
clean_imported_image        = false
keep_import_request         = false

// Source VM Image
//   The VirtualMachineImage resource name assigned by the Supervisor — this is
//   NOT the same as import_target_image_name (the content library friendly name).
//   After running `make upload`, discover the correct value with:
//     kubectl get virtualmachineimage -n <your-namespace>
//   The name is typically assigned by the Supervisor and differs from the label
//   you gave the content library item.
image_name = ""

// VM Class and Storage Class
//   Run:
//     kubectl get virtualmachineclass
//     kubectl get storageclass
class_name    = "best-effort-medium"
storage_class = "wcp-storage-policy"

// Source VM hardware
//   iso_boot_disk_size is the PVC allocated for the OS install.
//   watch_source_timeout_sec must cover ISO boot + Anaconda install + reboot.
guest_os_type            = "otherlinux64guest"
iso_boot_disk_size       = "40Gi"
watch_source_timeout_sec = 3600

// Source VM lifecycle
keep_input_artifact = false

// Publishing the customized image back to a content library.
//   The published item appears as an OVF template that can be downloaded
//   as an OVA via the vSphere Client or `govc library.export`.
// publish_location_name is the ContentLibrary CRD name (cl-xxxx) from the Supervisor,
// NOT the human-readable library label. Find it with:
//   kubectl get contentlibrary -n <your-namespace>
publish_location_name     = ""
publish_image_name        = ""
watch_publish_timeout_sec = 1800

// Guest Operating System Metadata (naming only)
vm_guest_os_family  = "linux"
vm_guest_os_name    = "oracle"
vm_guest_os_version = "9"

// Build credentials
//   Must match BUILD_USERNAME, BUILD_PASSWORD, and BUILD_PASSWORD_ENCRYPTED
//   used when running scripts/remaster-iso.sh.
//   Prefer setting sensitive values via environment variables:
//     export PKR_VAR_build_password="..."
//     export PKR_VAR_build_password_encrypted='$6$...'
build_username           = "packer"
build_password           = "VMware1!"
build_password_encrypted = "$6$eTPQ0ZoTtGVJLIsG$oy0/RpkPuxERn2v9tIZZlaCoel0ZFG3KwcqGnoCbOE/os0o77Dp7ENvK5r/NYQ.EYVvoRS91nqvZt4aNl1Ovn."
build_key                = ""

// SSH
communicator_port    = 22
communicator_timeout = "60m"

// Guest OS locale (used in kickstart — must match what was baked into the ISO)
vm_guest_os_language = "en_US"
vm_guest_os_keyboard = "us"
vm_guest_os_timezone = "UTC"
